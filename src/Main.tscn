[sub_resource type="Shader" id="Shader_radial_reveal"]
code = "shader_type canvas_item;

uniform float reveal : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec2 pixel_position = (UV - vec2(0.5)) / SCREEN_PIXEL_SIZE;
	float shortest_side = min(1.0 / SCREEN_PIXEL_SIZE.x, 1.0 / SCREEN_PIXEL_SIZE.y);
	float distance_from_center = length(pixel_position) / shortest_side;
	float visible_radius = reveal * 0.9;
	float darkness = 1.0 - smoothstep(visible_radius - 0.04, visible_radius + 0.04, distance_from_center);
	COLOR = vec4(0.0, 0.0, 0.0, 1.0 - darkness);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_radial_reveal"]
shader = SubResource("Shader_radial_reveal")
shader_parameter/reveal = 0.0

[sub_resource type="Shader" id="Shader_red_vignette"]
code = "shader_type canvas_item;

void fragment() {
	float distance_from_center = length((UV - vec2(0.5)) * 2.0);
	float edge_strength = smoothstep(0.2, 1.0, distance_from_center);
	float tint_opacity = mix(0.08, 0.72, edge_strength);
	COLOR = vec4(vec3(0.34, 0.10, 0.10), tint_opacity);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_red_vignette"]
shader = SubResource("Shader_red_vignette")

