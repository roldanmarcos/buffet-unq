[sub_resource type="Shader" id="Shader_spotlight"]
code = "shader_type canvas_item;

uniform vec2 center = vec2(0.0);
uniform vec2 rect_size = vec2(900.0, 648.0);
uniform float radius = 85.0;
uniform float strength = 0.0;

void fragment() {
	float d = distance(UV * rect_size, center);
	float outside = smoothstep(radius, radius + 22.0, d);
	COLOR = vec4(0.0, 0.0, 0.0, outside * strength);
}"

